DATABASE_URL=postgresql://postgres:postgres@localhost:5432/enterprise_mcp
UPLOAD_DIR=./uploads
MAX_FILE_SIZE_MB=50
ENABLE_RERANKER=true
RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
RETRIEVAL_TOP_K=20
RETRIEVAL_FINAL_K=7

# ── Google Drive Connector (Phase 4) ────────────────────────────────────────
# Path to your Google Service Account credentials JSON file
# Download from: Google Cloud Console → IAM → Service Accounts → Keys
GOOGLE_DRIVE_CREDENTIALS_JSON=/path/to/your/service_account.json

# ID of the Google Drive folder to watch (found in the folder's URL)
# Share this folder with your service account email address
GOOGLE_DRIVE_FOLDER_ID="your_google_drive_folder_id_here"

# How often the background scheduler syncs with Drive (in minutes)
GOOGLE_DRIVE_SYNC_INTERVAL_MINUTES=30

# Notion Integration
NOTION_API_KEY="secret_your_notion_integration_token_here"
NOTION_ROOT_PAGE_ID="your_notion_root_page_id_here"
NOTION_SYNC_INTERVAL_MINUTES=30
